# server.env.example — set private paths and generate a fresh TURN secret.
export RIDGE_BIND=0.0.0.0:8443
export RIDGE_MEDIA_BIND=0.0.0.0:40000
export RIDGE_PUBLIC_IP=192.0.2.10
export RIDGE_CERT=/etc/ridge/fullchain.pem
export RIDGE_KEY=/etc/ridge/server.key
export RIDGE_DB=/var/lib/ridge/ridge.db
export RIDGE_TURN_BIND=0.0.0.0:3478
export RIDGE_ICE_URLS='turn:radio.example.org:3478?transport=udp,turn:radio.example.org:3478?transport=tcp'
# Provide RIDGE_TURN_SECRET from private operator storage.
export RIDGE_RELAY_ONLY=0
